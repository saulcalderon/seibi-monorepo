# Copy to .env.local (gitignored) for local runs of the development variant.
# EAS builds read the same names from the EAS environment of their profile
# (development, preview, production). Only public values go here: every
# EXPO_PUBLIC_ variable is inlined into the app bundle.

# Supabase. The development variant points at seibi-dev: Project Settings → API
# (URL and the publishable key, sb_publishable_…).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth client ids from Google Cloud, per variant. Empty hides the
# Google button. The iOS id also sets the iOS URL scheme, so changing it
# needs a new native build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Not here: EXPO_PUBLIC_TEST_SIGN_IN (set by eas.json and the pnpm scripts,
# never in production) and the test account's credentials (SEIBI_TEST_EMAIL,
# SEIBI_TEST_PASSWORD: see the verify skill), which must never be inlined.
