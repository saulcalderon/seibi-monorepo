# Supabase — copy this file to .env.local and fill in real values.
# Find these in your Supabase project: Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push: the public half of the VAPID pair set as Edge Function secrets
# (see supabase/functions/README.md). Without it, notifications stay off.
VITE_VAPID_PUBLIC_KEY=

# Error monitoring. Leave empty to keep Sentry off.
VITE_SENTRY_DSN=

# Shown in Perfil. Optional.
VITE_APP_VERSION=
