{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_*", "EXPO_PUBLIC_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!project.inlang/.gitignore"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!project.inlang/.gitignore"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!project.inlang/.gitignore"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!project.inlang/.gitignore"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
